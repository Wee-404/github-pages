  <script>
    // Variáveis para os ícones (em SVG)
    const moonIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
      <path d="M6 0a6 6 0 0 1 4.472 10.472 5 5 0 1 0-4.472-10.472z"/>
    </svg>`;
    const sunIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
      <path d="M8 4.5a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1a.5.5 0 0 1 .5-.5zm0 6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1a.5.5 0 0 1 .5-.5zm3.536-4.536a.5.5 0 0 1 .354.854l-.707.707a.5.5 0 1 1-.707-.707l.707-.707a.5.5 0 0 1 .353-.147zm-7.07 0a.5.5 0 0 1 .354.147l.707.707a.5.5 0 1 1-.707.707l-.707-.707a.5.5 0 0 1 .354-.854zm7.07 3.536a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1 0-1h1a.5.5 0 0 1 .5.5zm-7.07 0a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1 0-1h1a.5.5 0 0 1 .5.5zm5.657-3.536a.5.5 0 0 1-.353.147l-.707-.707a.5.5 0 0 1 .707-.707l.707.707a.5.5 0 0 1-.354.854zm-7.071 0a.5.5 0 0 1-.354.147l-.707-.707a.5.5 0 0 1 .707-.707l.707.707a.5.5 0 0 1-.353.854zM8 0a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 0zm0 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>
    </svg>`;

    // Alterna o Dark Mode e atualiza o ícone
    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      const darkBtn = document.getElementById('darkModeToggle');
      darkBtn.innerHTML = document.body.classList.contains('dark-mode') ? sunIcon : moonIcon;
    }

    // Alterna entre as visualizações com efeito fade
    function toggleView() {
      var completeView = document.getElementById('completeView');
      var simplifiedView = document.getElementById('simplifiedView');
      var btn = document.getElementById('toggleViewBtn');

      if (completeView.style.display !== 'none') {
        completeView.style.opacity = 0;
        setTimeout(function() {
          completeView.style.display = 'none';
          simplifiedView.style.display = 'block';
          setTimeout(function() {
            simplifiedView.style.opacity = 1;
          }, 50);
        }, 500);
        btn.textContent = 'Versão Completa';
      } else {
        simplifiedView.style.opacity = 0;
        setTimeout(function() {
          simplifiedView.style.display = 'none';
          completeView.style.display = 'block';
          setTimeout(function() {
            completeView.style.opacity = 1;
          }, 50);
        }, 500);
        btn.textContent = 'Versão Simplificada';
      }
    }
    
    // Função para scroll suave para as seções Treino A ou Treino B
    function scrollToSection(letter) {
      var completeViewActive = document.getElementById('completeView').style.display !== 'none';
      var targetId = (letter === 'a') ? (completeViewActive ? 'treino-a' : 'simplified-treino-a') 
                                      : (completeViewActive ? 'treino-b' : 'simplified-treino-b');
      var target = document.getElementById(targetId);
      if(target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }
    
    // Botão Voltar ao Topo
    window.addEventListener("scroll", function() {
      var backToTop = document.getElementById("backToTop");
      if (document.body.scrollTop > 200 || document.documentElement.scrollTop > 200) {
        backToTop.style.display = "flex";
      } else {
        backToTop.style.display = "none";
      }
    });
    
    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    
    // Impede clique direito e atalhos para inspecionar o código (mantém segurança em iPhone)
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
    });
    document.onkeydown = function(e) {
      if (e.keyCode === 123 ||
          (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 74)) ||
          (e.ctrlKey && e.keyCode === 85)) {
        return false;
      }
    };

    // Inicializa o ícone de Dark Mode (modo claro por padrão)
    document.addEventListener("DOMContentLoaded", function() {
      document.getElementById('darkModeToggle').innerHTML = moonIcon;
    });
  </script>
</head>
