  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Treino</title>
  <!-- Importa uma fonte elegante do Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    /* Reset e Box Sizing */
    * {
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Calibri', sans-serif;
      background-color: #f5f5f5;
      color: #333;
      margin: 20px;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    /* Estilo para Dark Mode */
    .dark-mode {
      background-color: #1a1a1a;
      color: #ddd;
    }
    .dark-mode .header-container {
      background: linear-gradient(45deg, #1f3b70, #274d6a);
      color: #fff;
    }
    .dark-mode table {
      background-color: #333;
      color: #ddd;
    }
    .dark-mode th {
      background-color: #444;
      color: #ddd;
    }
    .dark-mode td {
      border-color: #555;
    }
    .dark-mode .toggle-btn,
    .dark-mode .nav-buttons button {
      background-color: #274d6a;
    }
    .dark-mode #backToTop {
      background: #274d6a;
    }
    /* Estilos para a visualização simplificada no modo claro */
    .simplified ul {
      list-style: none;
      padding: 0;
    }
    .simplified li {
      background: #fff;
      margin-bottom: 10px;
      padding: 10px;
      border-radius: 5px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }
    .simplified li strong {
      display: block;
      margin-bottom: 5px;
      color: #365f91;
    }
    /* Estilos para a visualização simplificada no modo escuro */
    .dark-mode .simplified li {
      background: #333;
      color: #ddd;
      box-shadow: 0 0 5px rgba(255,255,255,0.1);
    }
    .dark-mode .simplified li strong {
      color: #ddd;
    }
    /* Container centralizado e responsivo */
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 0 15px;
    }
    @media (min-width: 769px) {
      .container {
        max-width: 800px;
      }
    }
    /* Regras adicionais para computadores */
    @media (min-width: 1024px) {
      body {
        margin: 40px;
      }
      .container {
        max-width: 1000px;
        padding: 20px;
      }
      header {
        margin-bottom: 40px;
      }
      .header-container {
        padding: 60px 40px;
      }
      .header-container h1 {
        font-size: 4em;
      }
      .nav-buttons {
        margin: 30px 0;
      }
      .toggle-btn {
        width: 220px;
        font-size: 1.2em;
      }
      footer {
        font-size: 1.4em;
      }
    }
    header {
      margin-bottom: 20px;
    }
    /* Cabeçalho aprimorado e responsivo */
    .header-container {
      background: linear-gradient(45deg, #365f91, #4f81bd);
      padding: 40px 20px;
      border-radius: 15px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      color: #fff;
      text-align: center;
      overflow: hidden;
      position: relative;
    }
    .header-container h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3em;
      margin-bottom: 15px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
      word-wrap: break-word;
    }
    .header-info {
      display: flex;
      justify-content: center;
      gap: 30px;
      font-size: 1.2em;
      flex-wrap: wrap;
    }
    .header-info span {
      background: rgba(255, 255, 255, 0.25);
      padding: 8px 15px;
      border-radius: 8px;
    }
    /* Botão do Modo Escuro (ícone) posicionado no canto superior direito */
    #darkModeToggle {
      position: fixed;
      top: 20px;
      right: 20px;
      background: transparent;
      border: none;
      cursor: pointer;
      z-index: 1001;
      width: 40px;
      height: 40px;
      transition: transform 0.1s ease;
    }
    #darkModeToggle:hover {
      transform: scale(1.1);
    }
    /* Navegação por botões para os treinos */
    .nav-buttons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    .nav-buttons button {
      padding: 10px 20px;
      background-color: #4f81bd;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.3s ease, transform 0.1s ease;
    }
    .nav-buttons button:hover {
      background-color: #365f91;
    }
    /* Feedback visual: efeito de click */
    button:active {
      transform: scale(0.98);
    }
    /* Botão para alternar visualizações */
    .toggle-btn {
      display: block;
      width: 200px;
      margin: 20px auto;
      padding: 10px;
      background-color: #365f91;
      color: #fff;
      border: none;
      border-radius: 5px;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.3s ease, transform 0.1s ease;
    }
    .toggle-btn:hover {
      background-color: #4f81bd;
    }
    section {
      margin-bottom: 40px;
    }
    h2 {
      color: #4f81bd;
      font-size: 1.8em;
      margin-bottom: 10px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      background-color: #fff;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    th, td {
      padding: 12px;
      text-align: left;
      border: 1px solid #ddd;
      vertical-align: middle;
    }
    th {
      background-color: #f2f2f2;
    }
    /* Container responsivo para vídeos (16:9) */
    .video-container {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 */
      height: 0;
      overflow: hidden;
      max-width: 200px;
    }
    .video-container iframe,
    .video-container object,
    .video-container embed,
    .video-container video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    /* Responsividade para a tabela */
    @media screen and (max-width: 768px) {
      .header-container h1 {
        font-size: 2em;
      }
      .video-container {
        max-width: 100%;
      }
      table, thead, tbody, th, td, tr {
        display: block;
      }
      th {
        position: absolute;
        top: -9999px;
        left: -9999px;
      }
      tr {
        margin-bottom: 15px;
        border: 1px solid #ddd;
      }
      td {
        border: none;
        position: relative;
        padding-left: 50%;
      }
      td:before {
        position: absolute;
        top: 12px;
        left: 12px;
        width: 45%;
        padding-right: 10px;
        white-space: nowrap;
        font-weight: bold;
      }
      td:nth-of-type(1):before { content: "#"; }
      td:nth-of-type(2):before { content: "Exercício"; }
      td:nth-of-type(3):before { content: "Séries x Reps"; }
      td:nth-of-type(4):before { content: "Peso"; }
      td:nth-of-type(5):before { content: "Ajuste"; }
      td:nth-of-type(6):before { content: "Vídeo"; }
    }
    footer {
      text-align: center;
      margin-top: 40px;
      font-size: 1.2em;
      color: #365f91;
    }
    /* Efeitos de fade para alternância de visualizações */
    #completeView, #simplifiedView {
      transition: opacity 0.5s ease;
    }
    /* Estado inicial: visualização completa visível */
    #completeView {
      opacity: 1;
      display: block;
    }
    #simplifiedView {
      opacity: 0;
      display: none;
    }
    /* Botão Voltar ao Topo */
    #backToTop {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #365f91;
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      font-size: 1.5em;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      transition: background-color 0.3s ease;
    }
    #backToTop:hover {
      background: #4f81bd;
